TZ=Europe/Berlin
# The app's own address; devices use it too unless Settings → General says otherwise.
# Devices need https:// with a certificate from a public authority (Let's Encrypt is fine).
BASE_URL=https://devices.example.com
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me-please
# Connections can also be set under Settings in the UI.
# WEATHER_URL=http://pocket-weather:8080
# WEATHER_TOKEN=
# NOTIFY_URL=http://apprise:8000/notify/devices
# NOTIFY_FORMAT=apprise
# CORE_URL=http://pocket-core:8080
# CORE_REGISTRATION_KEY=
